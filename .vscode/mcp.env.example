# Copy this file to mcp.env and fill in values if needed.
#   macOS/Linux:  cp .vscode/mcp.env.example .vscode/mcp.env
#   Windows:      Copy-Item .vscode\mcp.env.example .vscode\mcp.env
#
# Leave a variable unset (commented) to inherit it from the OS / VS Code process.
# Do not commit passwords. Prefer User-level MCP config for secrets.

# --- Kubernetes ---
# One kubeconfig (defaults if unset):
# macOS/Linux:
# KUBECONFIG=/Users/you/.kube/config
# Windows:
# KUBECONFIG=C:\Users\you\.kube\config
#
# Several kubeconfig files (merged; then pick a context in chat):
# macOS/Linux — colon-separated:
# KUBECONFIG=/Users/you/.kube/config:/Users/you/.kube/staging.config:/Users/you/.kube/prod.config
# Windows — semicolon-separated (drive letters already use ':'):
# KUBECONFIG=C:\Users\you\.kube\config;C:\Users\you\.kube\staging.config
#
# After changing KUBECONFIG, restart the kubernetes-inspect MCP server.
# Isolated prod vs staging processes: copy .vscode/mcp.multi-cluster.example.json
# Restart kubernetes-inspect after editing this file.

# --- Corporate HTTP proxy ---
# Use http://, not https://  (Copilot does not support HTTPS proxies)
# HTTPS_PROXY=http://proxy.corp.example.com:8080
# HTTP_PROXY=http://proxy.corp.example.com:8080
# ALL_PROXY=http://proxy.corp.example.com:8080
# With basic auth (URL-encode special characters in the password):
# HTTPS_PROXY=http://username:password@proxy.corp.example.com:8080
#
# Do not send cluster or database traffic through the proxy:
# NO_PROXY=localhost,127.0.0.1,::1,.svc,.cluster.local,.internal.example.com,10.0.0.0/8,192.168.0.0/16

# --- TLS / SSL inspection (corporate root CA as PEM) ---
# macOS/Linux:
# NODE_EXTRA_CA_CERTS=/Users/you/certs/corp-root-ca.pem
# SSL_CERT_FILE=/Users/you/certs/corp-root-ca.pem
# CURL_CA_BUNDLE=/Users/you/certs/corp-root-ca.pem
# GIT_SSL_CAINFO=/Users/you/certs/corp-root-ca.pem
# NPM_CONFIG_CAFILE=/Users/you/certs/corp-root-ca.pem
# Windows:
# NODE_EXTRA_CA_CERTS=C:\Users\you\certs\corp-root-ca.pem
# SSL_CERT_FILE=C:\Users\you\certs\corp-root-ca.pem
# CURL_CA_BUNDLE=C:\Users\you\certs\corp-root-ca.pem
# GIT_SSL_CAINFO=C:\Users\you\certs\corp-root-ca.pem
# NPM_CONFIG_CAFILE=C:\Users\you\certs\corp-root-ca.pem
# NODE_USE_ENV_PROXY=1
# npm_config_https_proxy=http://proxy.corp.example.com:8080

# --- Optional databases (enable only the ones you need; Copilot 128-tool cap) ---
# Postgres
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=app
# POSTGRES_USER=readonly
# POSTGRES_PASSWORD=
# MySQL
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=app
# MYSQL_USER=readonly
# MYSQL_PASSWORD=
# Oracle
# ORACLE_CONNECTION_STRING=host:1521/servicename
# ORACLE_USERNAME=readonly
# ORACLE_PASSWORD=
# SQL Server
# MSSQL_HOST=127.0.0.1
# MSSQL_PORT=1433
# MSSQL_DATABASE=app
# MSSQL_USER=readonly
# MSSQL_PASSWORD=
# SQLite (file path the MCP process can read)
# SQLITE_DATABASE=/Users/you/data/app.db
# ClickHouse
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_USER=readonly
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=app
# CLICKHOUSE_PROTOCOL=http
# Elasticsearch
# ELASTICSEARCH_HOST=https://127.0.0.1:9200
# ELASTICSEARCH_APIKEY=
# Neo4j
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_DATABASE=neo4j
# NEO4J_USERNAME=readonly
# NEO4J_PASSWORD=
# Snowflake
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=readonly
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=
# MongoDB (official mongodb-mcp-server, always --readOnly)
# MDB_MCP_CONNECTION_STRING=mongodb://readonly@127.0.0.1:27017/app
# MDB_MCP_READ_ONLY=true

# --- Optional Grafana (Prometheus + Loki) ---
# Used when you run: ./scripts/init.sh --with-observability
#                   or .\scripts\init.ps1 -WithObservability
# Requires uvx (https://docs.astral.sh/uv/) and a Grafana service account token.
# GRAFANA_URL=https://grafana.example.com
# GRAFANA_SERVICE_ACCOUNT_TOKEN=
